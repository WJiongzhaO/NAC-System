# ============================================================
# NAC-System — Git 忽略规则
# ============================================================

# --- 密钥与环境 ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# 测试 / 类型检查 / 格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- 预训练模型（体积大，按需本地下载）---
pretrained_models/
*.onnx
*.onnx.json
*.pt
*.pth
*.bin

# --- 管线输出（TTS wav、评测报告、日志等）---
output/
*.log

# --- 生成音频（保留 data/test_audio 评测集）---
*.wav
!data/test_audio/*.wav

# --- FunASR / ASR 本地调试探针（实验临时输出）---
*_probe.txt
asr_stream_probe*.txt
asr_kwargs_*.txt
funasr_*.txt

# --- 本地统计与草稿（不上传）---
作业解读与项目初步规划.md
docs/
report/

# --- 操作系统 ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / 编辑器 ---
.idea/
.vscode/
.cursor/
.claude/
*.swp
*.swo
*~
